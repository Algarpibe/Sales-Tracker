{
  "name": "salestracker-pro",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e:db:up": "docker compose -f e2e/docker-compose.e2e.yml up -d --wait",
    "e2e:db:down": "docker compose -f e2e/docker-compose.e2e.yml down -v",
    "e2e:db:reset": "node e2e/db/reset.mjs",
    "db:migrate": "node scripts/migrate/cli.mjs",
    "test:e2e": "npm run e2e:db:up && npm run e2e:db:reset && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.104.5",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.577.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-grid-layout": "^2.3.0",
    "react-hook-form": "^7.90.0",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10",
    "eslint-config-next": "^16.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "brace-expansion@1": "^1.1.21",
    "brace-expansion@2": "^2.1.7",
    "brace-expansion@5": "^5.0.12"
  }
}
