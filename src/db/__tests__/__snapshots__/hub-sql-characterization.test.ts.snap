exports[`SQL del hub (caracterización) > getHubCommercialNotificationChanges 1`] = `
{
  "params": [
    2025,
    "Notificación Comercial",
  ],
  "sql": "SELECT h.ticket_id AS "ticketId",(extract(epoch from h.event_time)*1000)::float8 AS instante,s->'propertyValue'->>'previousValue' AS desde,s->'propertyValue'->>'updatedValue' AS hacia,t.number AS numero,a.name AS cliente FROM desk.ticket_history h CROSS JOIN LATERAL jsonb_array_elements(CASE WHEN jsonb_typeof(h.raw->'eventInfo')='array' THEN h.raw->'eventInfo' ELSE '[]'::jsonb END)s LEFT JOIN desk.tickets t ON t.id=h.ticket_id LEFT JOIN desk.accounts a ON a.id=t.account_id WHERE h.event_name='TicketUpdated' AND s->>'propertyName'='Status' AND$2::text IN(btrim(regexp_replace(normalize(s->'propertyValue'->>'previousValue',NFC),'[\\s\\u00a0]+',' ','g')),btrim(regexp_replace(normalize(s->'propertyValue'->>'updatedValue',NFC),'[\\s\\u00a0]+',' ','g')))AND h.event_time>=make_timestamptz($1::int,1,1,0,0,0,'America/Bogota')AND h.event_time<make_timestamptz($1::int+1,2,1,0,0,0,'America/Bogota')ORDER BY h.ticket_id,h.event_time",
}
`;

