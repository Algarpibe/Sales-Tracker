exports[`SQL del hub (caracterización) > getHubCategoryMonthSales INVOICE 1`] = `
{
  "params": [
    2025,
  ],
  "sql": "SELECT extract(month from h.date)::int AS mes,it.category_name AS categoria,round(sum(l.bcy_rate*l.quantity*COALESCE(1-COALESCE((h.raw->>'bcy_discount_total')::numeric,0)/NULLIF(h.bcy_sub_total,0),1))::numeric,2)::float8 AS importe FROM books.invoice_line_items l JOIN books.invoices h ON h.invoice_id=l.invoice_id JOIN books.items it ON it.item_id=l.item_id WHERE h.date>=make_date($1::int,1,1)AND h.date<make_date($1::int+1,1,1)AND l.bcy_rate IS NOT NULL AND h.status NOT IN('void','draft')GROUP BY extract(month from h.date),it.category_name",
}
`;

