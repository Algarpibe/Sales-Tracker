}
`;

exports[`SQL del hub (caracterización) > getHubMarginByYear SALES_ORDER 1`] = `
{
  "params": undefined,
  "sql": "SELECT extract(year from h.date)::int AS year,round(sum(l.bcy_rate*l.quantity*COALESCE(1-COALESCE((h.raw->>'bcy_discount_total')::numeric,0)/NULLIF(h.bcy_sub_total,0),1))::numeric,2)::float8 AS ventas,round(sum(NULLIF(it.raw->>'purchase_rate','')::numeric*l.quantity)::numeric,2)::float8 AS costo FROM books.salesorder_line_items l JOIN books.sales_orders h ON h.salesorder_id=l.salesorder_id JOIN books.items it ON it.item_id=l.item_id WHERE l.bcy_rate IS NOT NULL AND h.status NOT IN('void','draft')AND NULLIF(it.raw->>'purchase_rate','')::numeric>0 GROUP BY 1 ORDER BY 1",
}
`;

exports[`SQL del hub (caracterización) > getHubOrdersByIds 1`] = `
{
  "params": [
    [
      "so-1",
      "so-2",
    ],
  ],
  "sql": "SELECT s.salesorder_id AS hub_order_id,s.customer_name,s.date::text AS date,round(sum(l.bcy_rate*l.quantity*COALESCE(1-COALESCE((s.raw->>'bcy_discount_total')::numeric,0)/NULLIF(s.bcy_sub_total,0),1))::numeric,2)::float8 AS importe FROM books.salesorder_line_items l JOIN books.sales_orders s ON s.salesorder_id=l.salesorder_id WHERE s.salesorder_id=ANY($1::text[])GROUP BY s.salesorder_id,s.customer_name,s.date",
}
`;

exports[`SQL del hub (caracterización) > getHubSalesRows 1`] = `
{
  "params": undefined,
  "sql": "WITH ord AS(SELECT s.salesorder_id,s.date,(s.raw->>'invoiced_status')st,sum(l.bcy_rate*l.quantity)gross FROM books.salesorder_line_items l JOIN books.sales_orders s ON s.salesorder_id=l.salesorder_id WHERE s.date IS NOT NULL AND l.bcy_rate IS NOT NULL AND s.status NOT IN('void','draft')GROUP BY 1,2,3),oi AS(SELECT i.salesorder_id,sum(li.bcy_rate*li.quantity)inv FROM books.invoice_line_items li JOIN books.invoices i ON i.invoice_id=li.invoice_id WHERE i.salesorder_id IS NOT NULL AND i.salesorder_id<>'' AND li.bcy_rate IS NOT NULL AND i.status NOT IN('void','draft')GROUP BY 1),frac AS(SELECT o.salesorder_id,o.date,CASE WHEN o.st='not_invoiced' THEN 1 WHEN o.st='partially_invoiced' AND o.gross>0 THEN greatest(0,(o.gross-coalesce(oi.inv,0))/o.gross)ELSE 0 END f FROM ord o LEFT JOIN oi ON oi.salesorder_id=o.salesorder_id),lines AS(SELECT it.category_name cat,'INVOICE' rt,extract(year from i.date)::int yy,extract(month from i.date)::int mm,l.bcy_rate*l.quantity*COALESCE(1-COALESCE((i.raw->>'bcy_discount_total')::numeric,0)/NULLIF(i.bcy_sub_total,0),1)amt FROM books.invoice_line_items l JOIN books.invoices i ON i.invoice_id=l.invoice_id LEFT JOIN books.items it ON it.item_id=l.item_id WHERE i.date IS NOT NULL AND l.bcy_rate IS NOT NULL AND i.status NOT IN('void','draft')UNION ALL SELECT it.category_name,'SALES_ORDER',extract(year from s.date)::int,extract(month from s.date)::int,l.bcy_rate*l.quantity*COALESCE(1-COALESCE((s.raw->>'bcy_discount_total')::numeric,0)/NULLIF(s.bcy_sub_total,0),1)FROM books.salesorder_line_items l JOIN books.sales_orders s ON s.salesorder_id=l.salesorder_id LEFT JOIN books.items it ON it.item_id=l.item_id WHERE s.date IS NOT NULL AND l.bcy_rate IS NOT NULL AND s.status NOT IN('void','draft')UNION ALL SELECT it.category_name,'BACKLOG',extract(year from f.date)::int,extract(month from f.date)::int,l.bcy_rate*l.quantity*f.f FROM books.salesorder_line_items l JOIN frac f ON f.salesorder_id=l.salesorder_id LEFT JOIN books.items it ON it.item_id=l.item_id WHERE l.bcy_rate IS NOT NULL AND f.f>0)SELECT cat AS category_name,rt AS record_type,mm AS record_month,yy AS record_year,round(sum(amt),2)::float8 AS amount_usd FROM lines WHERE cat IS NOT NULL GROUP BY cat,rt,mm,yy",
}
`;

exports[`SQL del hub (caracterización) > getHubSalespeople 1`] = `
{
  "params": undefined,
  "sql": "SELECT DISTINCT nombre FROM(SELECT s.raw->>'salesperson_name' AS nombre FROM books.sales_orders s WHERE s.status NOT IN('void','draft')UNION SELECT i.raw->>'salesperson_name' FROM books.invoices i WHERE i.status NOT IN('void','draft'))t WHERE nombre IS NOT NULL AND nombre<>'' ORDER BY nombre",
}
`;

exports[`SQL del hub (caracterización) > getHubWonDealsMonth 1`] = `
{
  "params": [
    2025,
    [
      "Cerrado ganado",
    ],
    null,
  ],
  "sql": "SELECT d.account_name,extract(month from d.stage_modified_time AT TIME ZONE 'America/Bogota')::int AS mes,count(*)::int AS tratos FROM crm.deals d WHERE d.stage_modified_time IS NOT NULL AND d.stage_modified_time>=make_timestamptz($1::int,1,1,0,0,0,'America/Bogota')AND d.stage_modified_time<make_timestamptz($1::int+1,1,1,0,0,0,'America/Bogota')AND d.stage=ANY($2::text[])AND d.account_name IS NOT NULL AND($3::text IS NULL OR d.owner_name=$3)GROUP BY d.account_name,extract(month from d.stage_modified_time AT TIME ZONE 'America/Bogota')",
}
`;

exports[`SQL del hub (caracterización) > searchHubSalesOrders 1`] = `
{
  "params": [
    "%Cliente A%",
    2025,
  ],
  "sql": "SELECT s.salesorder_id AS hub_order_id,s.customer_name,s.date::text AS date,round(sum(l.bcy_rate*l.quantity*COALESCE(1-COALESCE((s.raw->>'bcy_discount_total')::numeric,0)/NULLIF(s.bcy_sub_total,0),1))::numeric,2)::float8 AS importe FROM books.salesorder_line_items l JOIN books.sales_orders s ON s.salesorder_id=l.salesorder_id WHERE s.status NOT IN('void','draft')AND(s.customer_name ILIKE$1 OR s.salesorder_id ILIKE$1)AND s.date>=make_date($2::int,1,1)AND s.date<make_date($2::int+1,1,1)GROUP BY s.salesorder_id,s.customer_name,s.date ORDER BY s.date DESC LIMIT 25",
}
`;
