# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claves sensibles - nunca versionar
scripts/keys.txt

# Informes de auditoría de seguridad — SOLO EN LOCAL.
# Este repositorio es PÚBLICO: estos documentos detallan hallazgos abiertos,
# rutas de ficheros con credenciales/PII e infraestructura. Publicarlos daría
# un mapa de ataque y quedaría en el historial de git de forma permanente.
AUDIT_*.md
REMEDIATION_*.md

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/

# storageState de los tests E2E: contiene cookies de sesión reales. Nunca versionar.
/e2e/.auth/

# Datos del historico de clientes: nombres reales e importes de Ambientalia.
# Este repositorio es PUBLICO. Ni las entradas ni el SQL generado se versionan.
/scripts/historico/
