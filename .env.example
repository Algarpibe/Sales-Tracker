# Base de datos Postgres (Drizzle + pg)
DATABASE_URL=postgres://user:password@host:5432/dbname
# Tamaño máximo del pool de conexiones (opcional, default 5)
# PG_POOL_MAX=5

# better-auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=genera-un-secreto-largo-y-aleatorio

# zoho-hub (solo lectura). Si se define, las ventas se leen EN VIVO del hub en vez
# de sales_records. Usuario read-only hub_reader. Host interno EasyPanel.
# HUB_DB_URL=postgres://hub_reader:<PASSWORD>@ambientalia_project_zoho-hub-db:5432/zoho-hub
# HUB_POOL_MAX=5

# Nombres de raw->>'salesperson_name' que NO son comerciales (procesos internos) y
# no deben aparecer en el selector de propietario de los KPIs. Opcional: sin
# definir no se excluye a nadie. Se separan por comas y se comparan ignorando
# mayúsculas y tildes. Sus ventas siguen contando en el total de la compañía.
# KPI_EXCLUDED_SALESPEOPLE=Nombre Generico,Otro Nombre Generico
